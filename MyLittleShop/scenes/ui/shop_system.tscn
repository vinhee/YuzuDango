script/source = "extends Control

var money : int = 0:
	set(value):
		money = value
		
		$UI/Currency.text = \"Gold: \" + str(value)

enum MODE {
	ON,
	OFF
}

var mode: MODE = MODE.OFF:
	set(value):
		mode = value
"

